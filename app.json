{
  "expo": {
    "name": "Mi Colón",
    "slug": "mi-ciudad",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "miciudad",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#185F65",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.grupo40.miciudad"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F8F5",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 240,
          "dark": {
            "backgroundColor": "#F6F8F5",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-image",
      [
        "expo-camera",
        {
          "cameraPermission": "Mi Colón utiliza la cámara para leer códigos QR turísticos.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Mi Colón permite elegir fotografías de tu galería para asociarlas a las visitas.",
          "cameraPermission": "Mi Colón utiliza la cámara para sacar fotografías de tus visitas.",
          "microphonePermission": false
        }
      ],
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Mi Colón utiliza tu ubicación para mostrar los lugares turísticos cercanos."
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Mi Colón utiliza Face ID/Huella para verificar tu identidad al reingresar."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8bea57e5-1862-4c69-abca-63217b497438"
      }
    },
    "owner": "mi-ciudad-grupo40"
  }
}
